[tools]
# Language Runtimes (pinned for stability)
go = "1.26.2"
node = "lts"
bun = "latest"
python = "3.14.4"

# Shell & Terminal
{{- if not .is_arch }}
starship = "latest"
zellij = "latest"
{{- end }}
zoxide = "latest"

{{- if not .is_arch }}

# Editor
helix = "latest"

# System Maintenance
"aqua:topgrade-rs/topgrade" = "latest"
{{- end }}

# Modern CLI Tools
watchexec = "latest"
eza = "latest"
fd = "latest"
ripgrep = "latest"
bat = "latest"
delta = "latest"
difftastic = "latest"
yazi = "latest"
fzf = "latest"
jq = "latest"
yq = "latest"
bottom = "latest"
xh = "latest"
hurl = "latest"
"github:unkn0wn-root/resterm" = "latest"
tlrc = "latest"  # tldr client
glow = "latest"
"aqua:ouch-org/ouch" = "latest"

{{- if not .is_arch }}

# Git & VCS
gh = "latest"
jj = "latest"

# Databases
duckdb = "latest"
{{- end }}

# CI/CD & DevOps
dagger = "latest"
task = "latest"
"aqua:terrastruct/d2" = "latest"

# Cloud CLIs
awscli = "latest"
cloudflared = "latest"

# Build Tools
buf = "latest"
shfmt = "latest"
golangci-lint = "latest"
cue = "latest"

# Python Tools
uv = "latest"

# Secrets Management
doppler = "latest"

# Recording & Media
"aqua:asciinema/asciinema" = "latest"
"aqua:asciinema/agg" = "latest"
yt-dlp = "latest"

{{- if not .is_arch }}

# Chezmoi (self-managing)
chezmoi = "latest"
{{- end }}

# NPM Global Packages
"npm:@anthropic-ai/claude-code" = "latest"

[settings]
experimental = true
